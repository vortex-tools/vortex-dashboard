# Loaded by `vite build --mode staging` (npm run build:staging).
#
# Marks the deploy: the primary palette compiles orange instead of purple
# (vite.config.ts -> _user-variables.scss) and the brand reads
# "vortex staging explorer".
VITE_DEPLOY_ENV=staging

# Tab title and icon. favicon-staging.ico is favicon.ico gradient-mapped to a
# red-orange (#F03C00) / yellow (#FFD500) duotone, with the center replaced by
# a white gear.
VITE_APP_TITLE="Vortex Staging | Validator Explorer"
VITE_FAVICON=/favicon-staging.ico
VITE_THEME_COLOR="#F56A14"

# Staging talks to the staging API. Its CORS allows https://staging.vx.tools;
# the production API only allows https://app.vx.tools.
VITE_API_BASE_URL=https://api.staging.vx.tools

