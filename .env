VITE_TITLE=Vortex
VITE_VERSION=1.0.0

# Substituted into index.html at build time (%VITE_APP_TITLE% / %VITE_FAVICON%).
# .env.staging overrides both so a staging tab is distinguishable at a glance.
VITE_APP_TITLE="Vortex | Validator Explorer"
VITE_FAVICON=/favicon.ico
# Browser chrome color on mobile (<meta name="theme-color">).
VITE_THEME_COLOR="#9A65FF"

# Deploy environment. Empty everywhere except the staging build
# (.env.staging), which gets an orange primary palette (vite.config.ts ->
# _user-variables.scss) and "vortex staging explorer" branding (NavbarBrand).
VITE_DEPLOY_ENV=
