# Loaded by `vite build --mode testnet` (npm run build:testnet) for
# testnet.vx.tools.
#
# The dashboard's main code against the testnet API (which runs
# vortex-data's main branch; only the staging API runs its staging
# branch), without the API selector: the pink testnet palette
# always on (the staging orange recolored, vite.config.ts), and the
# brand reads "vortex testnet explorer" from /epochs/current's cluster.
VITE_DEPLOY_ENV=testnet

VITE_APP_TITLE="Vortex Testnet | Validator Explorer"
VITE_FAVICON=/favicon-testnet.ico
VITE_THEME_COLOR="#C20C67"

# The testnet API; its CORS allows https://testnet.vx.tools.
VITE_API_BASE_URL=https://api.testnet.vx.tools
